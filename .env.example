# Copy to .env and fill in. All VITE_* vars are embedded in the client bundle.

# Passphrase for the #/stats page. Falls back to "civicchain" if unset.
# This is a light gate, not real security (see README).
VITE_STATS_PASSPHRASE=civicchain

# ── Firebase (shared tallies + saved inquiries) ─────────────────────────────
# From Firebase console → Project settings → Your apps → Web app → firebaseConfig.
# These are NOT secrets. Leave all blank to run in browser-only demo mode, where
# tallies are kept in this browser's localStorage.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check reCAPTCHA v3 site key (optional, recommended for a public form).
VITE_RECAPTCHA_SITE_KEY=
